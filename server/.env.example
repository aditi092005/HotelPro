PORT=8001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/HotelPro
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cookie settings (use COOKIE_SAMESITE=none only if client and API are on different sites over HTTPS)
COOKIE_SAMESITE=lax

# Booking policy
HOTEL_TZ_OFFSET_MINUTES=330
MAX_NIGHTS=30
MAX_ADVANCE_DAYS=365
HOLD_MINUTES=15
FREE_CANCEL_HOURS=48

# Payments: leave the Razorpay keys empty to run in clearly-labelled SANDBOX mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used only by `npm run create-admin`
ADMIN_NAME=Hotel Admin
ADMIN_EMAIL=admin@hotelpro.local
ADMIN_PASSWORD=ChangeMe123!
